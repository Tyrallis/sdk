WXL_OBJECT_READ(Units, unit_power_type,         UnitPowerType,       uint32_t)
WXL_OBJECT_READ(Units, unit_race,               UnitRace,            uint32_t)
WXL_OBJECT_READ(Units, unit_class,              UnitClass,           uint32_t)
WXL_OBJECT_READ(Units, unit_sex,                UnitSex,             uint32_t)
WXL_OBJECT_FIELD(Units, unit_display_id,        UnitDisplayId,       uint32_t)
WXL_OBJECT_FIELD(Units, unit_native_display_id, UnitNativeDisplayId, uint32_t)
WXL_OBJECT_FIELD(Units, unit_mount_display_id,  UnitMountDisplayId,  uint32_t)
WXL_OBJECT_FIELD(Units, unit_faction_template,  UnitFactionTemplate, uint32_t)
WXL_OBJECT_FIELD(Units, unit_flags,             UnitFlags,           uint32_t)
WXL_OBJECT_FIELD(Units, unit_flags2,            UnitFlags2,          uint32_t)
WXL_OBJECT_FIELD(Units, unit_dynamic_flags,     UnitDynamicFlags,    uint32_t)
WXL_OBJECT_FIELD(Units, unit_npc_flags,         UnitNpcFlags,        uint32_t)
WXL_OBJECT_FIELD(Units, unit_bounding_radius,   UnitBoundingRadius,  float)
WXL_OBJECT_FIELD(Units, unit_combat_reach,      UnitCombatReach,     float)
WXL_OBJECT_FIELD(Units, unit_charm,             UnitCharm,           wxl_guid)
WXL_OBJECT_FIELD(Units, unit_summon,            UnitSummon,          wxl_guid)
WXL_OBJECT_FIELD(Units, unit_charmed_by,        UnitCharmedBy,       wxl_guid)
WXL_OBJECT_FIELD(Units, unit_summoned_by,       UnitSummonedBy,      wxl_guid)
WXL_OBJECT_FIELD(Units, unit_created_by,        UnitCreatedBy,       wxl_guid)

