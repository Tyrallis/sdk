//
// The reads behind wxl.object: one row per getter of wxl_object_api that reads one value of an
// object. The getters that resolve handles or walk the table (valid, guid, type, from_guid,
// local_player, name, unit_target, enumerate, positions) are written by hand in
// object_service.cpp.
//
//   WXL_OBJECT_FIELD(kinds, member, Method, type)    a field of the object, read as is
//   WXL_OBJECT_READ(kinds, member, Method, type)     a value the runtime works out
//   WXL_OBJECT_READ_AT(kinds, member, Method, type)  the same, with an index
//
//   kinds   the objects the getter accepts: Any, Units, Players, Items, Containers,
//           GameObjects, Dynamics or Corpses. Any other live handle answers WXL_E_INVALID.
//   member  the wxl_object_api member the getter is published as.
//   Method  the ObjectBinding read behind it: bool Method(void* object, type& out) const, or
//           bool Method(void* object, uint32_t index, type& out) const for READ_AT.
//   type    what the getter writes.
//
// A runtime implements each Method. The FIELD shape tells it the value needs no work: the core
// answers it from the binding fact of the same name as `member`.
//
// Include with WXL_OBJECT_READ_AT and WXL_OBJECT_READ defined; WXL_OBJECT_FIELD defaults to
// WXL_OBJECT_READ.

#ifndef WXL_OBJECT_READ
#error "define WXL_OBJECT_READ(kinds, member, Method, type) before including object_reads.def"
#endif
#ifndef WXL_OBJECT_READ_AT
#error "define WXL_OBJECT_READ_AT(kinds, member, Method, type) before including object_reads.def"
#endif
#ifndef WXL_OBJECT_FIELD
    #define WXL_OBJECT_FIELD(kinds, member, Method, type) WXL_OBJECT_READ(kinds, member, Method, type)
    #define WXL_OBJECT_FIELD_DEFAULTED
#endif

// --- Any object ----------------------------------------------------------------------------

WXL_OBJECT_READ(Any, position, Position, wxl_vec3)
WXL_OBJECT_READ(Any, facing,   Facing,   float)
WXL_OBJECT_READ(Any, entry,    Entry,    uint32_t)
WXL_OBJECT_READ(Any, scale,    Scale,    float)

