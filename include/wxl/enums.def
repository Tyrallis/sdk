WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_BUSY,             0, busy)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_PROPOSED,         1, proposed)        ///< someone asks the player to trade
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_INITIATED,        2, initiated)       ///< the window opens
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_CANCELLED,        3, cancelled)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_ACCEPTED,         4, accepted)        ///< the other side accepted
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_ALREADY_TRADING,  5, already_trading)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_NOT_FOUND,        6, not_found)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_STATE_CHANGED,    7, state_changed)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_COMPLETE,         8, complete)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_UNACCEPTED,       9, unaccepted)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_TOO_FAR,         10, too_far)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_WRONG_FACTION,   11, wrong_faction)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_FAILED,          12, failed)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_CLOSED,          13, closed)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_IGNORED,         14, ignored)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_STUNNED,         15, stunned)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_TARGET_STUNNED,  16, target_stunned)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_DEAD,            17, dead)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_TARGET_DEAD,     18, target_dead)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_LOGGING_OUT,     19, logging_out)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_TARGET_LOGGING_OUT, 20, target_logging_out)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_RESTRICTED,      21, restricted)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_WRONG_REALM,     22, wrong_realm)
WXL_ENUM_VALUE(wxl_trade_status, WXL_TRADE_NOT_ON_TAPLIST,  23, not_on_taplist)
WXL_ENUM_END(wxl_trade_status)

/// A window of the interface that opens on someone the player talks to.
WXL_ENUM(wxl_window_kind)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_GOSSIP,     0, gossip)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_MERCHANT,   1, merchant)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_TRAINER,    2, trainer)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_BANK,       3, bank)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_AUCTION,    4, auction)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_MAIL,       5, mail)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_TAXI,       6, taxi)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_TRADE,      7, trade)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_QUEST,      8, quest)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_GUILD_BANK, 9, guild_bank)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_STABLE,    10, stable)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_PETITION,  11, petition)
WXL_ENUM_VALUE(wxl_window_kind, WXL_WINDOW_TABARD,    12, tabard)
WXL_ENUM_END(wxl_window_kind)

#ifdef WXL_ENUM_DEFAULTED
    #undef WXL_ENUM
    #undef WXL_ENUM_DEFAULTED
#endif
#ifdef WXL_ENUM_END_DEFAULTED
    #undef WXL_ENUM_END
    #undef WXL_ENUM_END_DEFAULTED
#endif
