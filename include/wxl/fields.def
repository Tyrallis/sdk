// SPDX-License-Identifier: MIT
// Copyright (c) 2026 WarcraftXL
//
// The args table: every struct an event of events.def carries, member by member, with what each
// member holds. events.h declares the structs from these rows, and a runtime that hands events to
// something other than C -- a script VM, a log, a recorder -- reads them through the same rows
// (wxl/reflect.hpp), so the struct and its description are one text. The rows are also a
// handler's parameters, in C++ (sdk.hpp) and in Lua: one per member, in this order.
//
//   WXL_ARGS(args)                            opens a struct
//   WXL_ARGS_FIELD(args, member, kind)        a value, read as it is
//   WXL_ARGS_BYTES(args, member, size)        `const void*` to `size` bytes, valid for the call
//   WXL_ARGS_ANSWER(args, member)             `wxl_bool*` a handler writes WXL_TRUE through
//   WXL_ARGS_BUFFER(args, member, capacity)   `char*` a handler writes a NUL-terminated string
//                                             into, at most `capacity` bytes with the terminator
//   WXL_ARGS_PTR(args, member, type)          an address of C type `type`, for native code only
//   WXL_ARGS_ENUM(args, member, type)         a `uint32_t` holding a value of the enumeration
//                                             `type` of enums.def
//   WXL_ARGS_VALUE(args, member, type, field) a `uint64_t` holding the dwords of an update
//                                             field, low first: the field whose dword index the
//                                             member `field` holds, of an object of the
//                                             wxl_object_type the member `type` holds
//                                             (update_fields.def says what the value is)
//   WXL_ARGS_END(args)                        closes it
//
// Columns:
//
//   args    the struct's name, as events.def names it
//   member  the member's name
//   kind    what the value means, which also gives its C type:
//             u32 i32 u64 i64 f32   uint32_t int32_t uint64_t int64_t float
//             bool                  wxl_bool
//             handle                wxl_handle: a client object, through wxl.object
//             guid                  wxl_guid: the server's id for an object
//             vec3                  wxl_vec3
//             str                   wxl_str, valid for the call
//   size, capacity   the member of the same struct holding the length; a handler gets it through
//                    the bytes or the buffer, not as a parameter of its own
//
// The rows of a struct are its members in declaration order, so a member is appended at the end
// of its struct and never moved: the struct is part of the ABI. A new struct gets its block here,
// the event that carries it its row in events.def.
//
// Include with WXL_ARGS_FIELD defined. WXL_ARGS and WXL_ARGS_END default to nothing; the other
// shapes default to WXL_ARGS_FIELD with their own kind -- bytes, answer, buffer, ptr -- for a
// consumer that only wants the members, an enum to WXL_ARGS_FIELD with kind u32 and a value to
// WXL_ARGS_FIELD with kind u64, which is what the struct holds.

#ifndef WXL_ARGS_FIELD
#error "define WXL_ARGS_FIELD(args, member, kind) before including fields.def"
#endif

#ifndef WXL_ARGS_BYTES
    #define WXL_ARGS_BYTES(args, member, size) WXL_ARGS_FIELD(args, member, bytes)
    #define WXL_ARGS_BYTES_DEFAULTED
#endif
#ifndef WXL_ARGS_ANSWER
    #define WXL_ARGS_ANSWER(args, member) WXL_ARGS_FIELD(args, member, answer)
    #define WXL_ARGS_ANSWER_DEFAULTED
#endif
#ifndef WXL_ARGS_BUFFER
    #define WXL_ARGS_BUFFER(args, member, capacity) WXL_ARGS_FIELD(args, member, buffer)
    #define WXL_ARGS_BUFFER_DEFAULTED
#endif
#ifndef WXL_ARGS_PTR
    #define WXL_ARGS_PTR(args, member, type) WXL_ARGS_FIELD(args, member, ptr)
    #define WXL_ARGS_PTR_DEFAULTED
#endif
#ifndef WXL_ARGS_ENUM
    #define WXL_ARGS_ENUM(args, member, type) WXL_ARGS_FIELD(args, member, u32)
    #define WXL_ARGS_ENUM_DEFAULTED
#endif
#ifndef WXL_ARGS_VALUE
    #define WXL_ARGS_VALUE(args, member, type, field) WXL_ARGS_FIELD(args, member, u64)
    #define WXL_ARGS_VALUE_DEFAULTED
#endif
#ifndef WXL_ARGS
    #define WXL_ARGS(args)
    #define WXL_ARGS_DEFAULTED
#endif
#ifndef WXL_ARGS_END
    #define WXL_ARGS_END(args)
    #define WXL_ARGS_END_DEFAULTED
#endif

/// A frame's identity and length. Shared by every slot in the frame.
WXL_ARGS(wxl_frame_args)
WXL_ARGS_FIELD(wxl_frame_args, index, u64) ///< monotonic frame counter since startup
WXL_ARGS_FIELD(wxl_frame_args, delta, f32) ///< seconds since the previous frame
WXL_ARGS_END(wxl_frame_args)

/// The logic tick.
WXL_ARGS(wxl_update_args)
WXL_ARGS_FIELD(wxl_update_args, delta, f32) ///< seconds since the previous tick
WXL_ARGS_END(wxl_update_args)

/// Entering or leaving a map.
WXL_ARGS(wxl_world_args)
WXL_ARGS_FIELD(wxl_world_args, map_id, u32)
WXL_ARGS_FIELD(wxl_world_args, position, vec3) ///< where the player is, or was
WXL_ARGS_END(wxl_world_args)

/// A click that landed in the world.
WXL_ARGS(wxl_world_click_args)
WXL_ARGS_FIELD(wxl_world_click_args, point, vec3)    ///< where the ray met the world
WXL_ARGS_FIELD(wxl_world_click_args, object, handle) ///< what was hit, or WXL_HANDLE_NONE for bare ground
WXL_ARGS_ENUM(wxl_world_click_args, button, wxl_mouse_button)
WXL_ARGS_END(wxl_world_click_args)

/// A platform input message, before the client sees it.
WXL_ARGS(wxl_input_args)
WXL_ARGS_FIELD(wxl_input_args, message, u32) ///< platform message id
WXL_ARGS_FIELD(wxl_input_args, wparam, u64)
WXL_ARGS_FIELD(wxl_input_args, lparam, i64)
WXL_ARGS_ANSWER(wxl_input_args, handled)     ///< write WXL_TRUE to keep the client from seeing it
WXL_ARGS_END(wxl_input_args)

/// A sound about to play.
WXL_ARGS(wxl_sound_args)
WXL_ARGS_FIELD(wxl_sound_args, sound_id, u32) ///< client sound id, 0 when the sound was named by path
WXL_ARGS_FIELD(wxl_sound_args, path, str)     ///< source path, empty when the sound came from an id
WXL_ARGS_ANSWER(wxl_sound_args, suppressed)   ///< write WXL_TRUE to drop it
WXL_ARGS_END(wxl_sound_args)

/// Swapchain resources going away and coming back.
WXL_ARGS(wxl_swapchain_args)
WXL_ARGS_FIELD(wxl_swapchain_args, width, u32)
WXL_ARGS_FIELD(wxl_swapchain_args, height, u32)
WXL_ARGS_END(wxl_swapchain_args)

/// An object appearing, changing or leaving.
WXL_ARGS(wxl_object_args)
WXL_ARGS_FIELD(wxl_object_args, object, handle)
WXL_ARGS_FIELD(wxl_object_args, guid, guid)
WXL_ARGS_ENUM(wxl_object_args, type, wxl_object_type)
WXL_ARGS_END(wxl_object_args)

/// The player's target moving from one object to another.
WXL_ARGS(wxl_target_args)
WXL_ARGS_FIELD(wxl_target_args, previous, handle) ///< WXL_HANDLE_NONE when nothing was targeted
WXL_ARGS_FIELD(wxl_target_args, current, handle)  ///< WXL_HANDLE_NONE when the target was cleared
WXL_ARGS_END(wxl_target_args)

/// A doodad placed by the map.
WXL_ARGS(wxl_doodad_args)
WXL_ARGS_FIELD(wxl_doodad_args, doodad, handle)
WXL_ARGS_FIELD(wxl_doodad_args, path, str)      ///< the model it was built from
WXL_ARGS_FIELD(wxl_doodad_args, position, vec3)
WXL_ARGS_END(wxl_doodad_args)

/// A unit's visible equipment changing.
WXL_ARGS(wxl_equipment_args)
WXL_ARGS_FIELD(wxl_equipment_args, unit, handle)
WXL_ARGS_FIELD(wxl_equipment_args, slot, u32)
WXL_ARGS_FIELD(wxl_equipment_args, item_id, u32) ///< 0 when the slot was cleared
WXL_ARGS_END(wxl_equipment_args)

/// A model's bytes, before the parse.
WXL_ARGS(wxl_model_load_args)
WXL_ARGS_FIELD(wxl_model_load_args, path, str)
WXL_ARGS_BYTES(wxl_model_load_args, data, size)                ///< the bytes as read; valid for the call only
WXL_ARGS_FIELD(wxl_model_load_args, size, u32)
WXL_ARGS_PTR(wxl_model_load_args, replacement, const void**)   ///< write a buffer here to parse it instead of @ref data
WXL_ARGS_PTR(wxl_model_load_args, replacement_size, uint32_t*) ///< its length; the writer keeps it alive until the next load
WXL_ARGS_END(wxl_model_load_args)

/// A texture requested by name.
WXL_ARGS(wxl_texture_load_args)
WXL_ARGS_FIELD(wxl_texture_load_args, path, str)
WXL_ARGS_END(wxl_texture_load_args)

/// A terrain chunk being built.
WXL_ARGS(wxl_terrain_chunk_args)
WXL_ARGS_FIELD(wxl_terrain_chunk_args, map_id, u32)
WXL_ARGS_FIELD(wxl_terrain_chunk_args, tile_x, i32)  ///< the tile the chunk belongs to
WXL_ARGS_FIELD(wxl_terrain_chunk_args, tile_y, i32)  ///< the tile the chunk belongs to
WXL_ARGS_FIELD(wxl_terrain_chunk_args, chunk_x, i32) ///< the chunk inside that tile
WXL_ARGS_FIELD(wxl_terrain_chunk_args, chunk_y, i32) ///< the chunk inside that tile
WXL_ARGS_END(wxl_terrain_chunk_args)

/// A map object's root, before its sub-chunks are walked.
WXL_ARGS(wxl_map_object_args)
WXL_ARGS_FIELD(wxl_map_object_args, path, str)
WXL_ARGS_BYTES(wxl_map_object_args, data, size) ///< the root bytes; valid for the call only
WXL_ARGS_FIELD(wxl_map_object_args, size, u32)
WXL_ARGS_END(wxl_map_object_args)

/**
 * @brief A file about to be opened by name.
 *
 * Writing a NUL-terminated path into @ref redirect opens that instead. This is how a mod replaces
 * an asset without touching an archive. The last handler to write wins, so a handler that cares
 * reads @ref redirect first to see whether another already answered.
 */
WXL_ARGS(wxl_file_open_args)
WXL_ARGS_FIELD(wxl_file_open_args, path, str)                    ///< what was asked for
WXL_ARGS_BUFFER(wxl_file_open_args, redirect, redirect_capacity) ///< empty on entry; write a path here to answer with another file
WXL_ARGS_FIELD(wxl_file_open_args, redirect_capacity, u32)       ///< bytes available in @ref redirect, terminator included
WXL_ARGS_END(wxl_file_open_args)

/// The result of an open.
WXL_ARGS(wxl_file_opened_args)
WXL_ARGS_FIELD(wxl_file_opened_args, path, str)   ///< the path actually opened, after any redirect
WXL_ARGS_FIELD(wxl_file_opened_args, found, bool)
WXL_ARGS_FIELD(wxl_file_opened_args, size, u32)   ///< bytes, 0 when not found
WXL_ARGS_END(wxl_file_opened_args)

/**
 * @brief A client database that finished loading.
 *
 * The records are the file's own rows, a flat array of @ref record_size bytes each -- a file
 * format, not a client structure, so reading them is portable. They stay valid until the database
 * is unloaded.
 */
WXL_ARGS(wxl_client_db_args)
WXL_ARGS_FIELD(wxl_client_db_args, name, str)          ///< the file it came from, e.g. "Spell.dbc"
WXL_ARGS_PTR(wxl_client_db_args, records, const void*)
WXL_ARGS_FIELD(wxl_client_db_args, record_count, u32)
WXL_ARGS_FIELD(wxl_client_db_args, record_size, u32)
WXL_ARGS_END(wxl_client_db_args)

/**
 * @brief A message crossing to or from the server.
 *
 * @ref data is the wire body, positioned after the opcode and before any client parsing. It is
 * valid for the call only. Suppressing an incoming message hides it from the client entirely,
 * which is how a mod serves an opcode the client does not know; suppressing an outgoing one stops
 * it being sent.
 */
WXL_ARGS(wxl_message_args)
WXL_ARGS_FIELD(wxl_message_args, opcode, u32)
WXL_ARGS_BYTES(wxl_message_args, data, size)
WXL_ARGS_FIELD(wxl_message_args, size, u32)
WXL_ARGS_ANSWER(wxl_message_args, suppressed) ///< write WXL_TRUE to stop it going any further
WXL_ARGS_END(wxl_message_args)

/// The connection to the world server coming up or going away.
WXL_ARGS(wxl_connection_args)
WXL_ARGS_FIELD(wxl_connection_args, address, str) ///< what was connected to; empty when the runtime does not expose it
WXL_ARGS_END(wxl_connection_args)

/**
 * @brief A script context coming up or going down.
 *
 * Both contexts are created and destroyed more than once in a session, so anything registered on
 * one has to be registered again on the next.
 *
 * @ref native_state is the VM's own state pointer, for a mod that wants to talk to the VM
 * directly. Using it ties the mod to that VM and to that runtime; the script service is the
 * portable way to register a function.
 */
WXL_ARGS(wxl_script_vm_args)
WXL_ARGS_ENUM(wxl_script_vm_args, context, wxl_script_context)
WXL_ARGS_PTR(wxl_script_vm_args, native_state, void*) ///< the VM's state, or NULL when the runtime does not expose one
WXL_ARGS_END(wxl_script_vm_args)

/// Something that happened to a unit.
WXL_ARGS(wxl_unit_args)
WXL_ARGS_FIELD(wxl_unit_args, unit, handle)
WXL_ARGS_END(wxl_unit_args)

/// An aura appearing on or leaving a unit.
WXL_ARGS(wxl_unit_aura_args)
WXL_ARGS_FIELD(wxl_unit_aura_args, unit, handle)
WXL_ARGS_FIELD(wxl_unit_aura_args, spell_id, u32)
WXL_ARGS_FIELD(wxl_unit_aura_args, removed, bool) ///< WXL_TRUE when the aura left, WXL_FALSE when it was applied
WXL_ARGS_END(wxl_unit_aura_args)

/**
 * @brief A cast a unit in view started (SpellCastStart) or released (SpellCastGo).
 *
 * Read off the server's message before the client parses it. A handle resolves only for an
 * object the client holds; the guids are what the server sent whether or not it does.
 */
WXL_ARGS(wxl_spell_cast_args)
WXL_ARGS_FIELD(wxl_spell_cast_args, caster, handle)    ///< WXL_HANDLE_NONE when the caster is not in view
WXL_ARGS_FIELD(wxl_spell_cast_args, caster_guid, guid)
WXL_ARGS_FIELD(wxl_spell_cast_args, target, handle)    ///< the object target; WXL_HANDLE_NONE when none, or not in view
WXL_ARGS_FIELD(wxl_spell_cast_args, target_guid, guid) ///< 0 when the cast has no object target
WXL_ARGS_FIELD(wxl_spell_cast_args, cast_item, guid)   ///< the item the cast came from, 0 when none
WXL_ARGS_FIELD(wxl_spell_cast_args, spell_id, u32)
WXL_ARGS_FIELD(wxl_spell_cast_args, cast_count, u32)   ///< the caster's count of the cast, as the server echoes it
WXL_ARGS_FIELD(wxl_spell_cast_args, cast_flags, u32)   ///< the server's cast flags
WXL_ARGS_FIELD(wxl_spell_cast_args, target_flags, u32) ///< the server's target flags
WXL_ARGS_FIELD(wxl_spell_cast_args, cast_time, u32)    ///< milliseconds; SpellCastStart only, 0 on SpellCastGo
WXL_ARGS_FIELD(wxl_spell_cast_args, hit_count, u32)    ///< units the cast hit; SpellCastGo only, 0 on SpellCastStart
WXL_ARGS_FIELD(wxl_spell_cast_args, miss_count, u32)   ///< units it missed; SpellCastGo only, 0 on SpellCastStart
WXL_ARGS_BYTES(wxl_spell_cast_args, hits, hits_size)   ///< the guids hit, @ref hit_count of 8 bytes each, little-endian; NULL when none
WXL_ARGS_FIELD(wxl_spell_cast_args, hits_size, u32)    ///< bytes in @ref hits
WXL_ARGS_BYTES(wxl_spell_cast_args, misses, misses_size) ///< the guids missed, @ref miss_count of 8 bytes each, little-endian; NULL when none
WXL_ARGS_FIELD(wxl_spell_cast_args, misses_size, u32)  ///< bytes in @ref misses
WXL_ARGS_BYTES(wxl_spell_cast_args, miss_reasons, miss_count) ///< one byte per miss, the server's SPELL_MISS_* code, in the order of @ref misses; NULL when none
WXL_ARGS_END(wxl_spell_cast_args)

/**
 * @brief A cast that did not go through.
 *
 * SpellCastFailed is the local player's own cast, refused by the server (SMSG_CAST_FAILED) or
 * by the client before it asked; SpellCastInterrupted is a cast in progress that the server
 * stopped (SMSG_SPELL_FAILURE), for any caster in view. @ref reason is the client's
 * SPELL_FAILED_* code in both.
 */
WXL_ARGS(wxl_spell_fail_args)
WXL_ARGS_FIELD(wxl_spell_fail_args, caster, handle)    ///< WXL_HANDLE_NONE when the caster is not in view
WXL_ARGS_FIELD(wxl_spell_fail_args, caster_guid, guid)
WXL_ARGS_FIELD(wxl_spell_fail_args, spell_id, u32)
WXL_ARGS_FIELD(wxl_spell_fail_args, cast_count, u32)
WXL_ARGS_FIELD(wxl_spell_fail_args, reason, u32)
WXL_ARGS_FIELD(wxl_spell_fail_args, custom_error, i32) ///< the error sent with SPELL_FAILED_CUSTOM_ERROR, -1 for none
WXL_ARGS_FIELD(wxl_spell_fail_args, custom_arg, i32)   ///< its argument, -1 for none
WXL_ARGS_END(wxl_spell_fail_args)

/**
 * @brief The local player asking to cast a spell, before the client checks or sends anything.
 *
 * Writing WXL_TRUE through @ref refused answers the client as a cast it could not make, and
 * nothing is sent. Raised at every ask, including the client's own second ask once a target
 * has been picked or a dialog confirmed, which @ref confirmed tells apart.
 */
WXL_ARGS(wxl_spell_request_args)
WXL_ARGS_FIELD(wxl_spell_request_args, caster, handle)    ///< the player, or the pet or charmed unit it casts through
WXL_ARGS_FIELD(wxl_spell_request_args, spell_id, u32)
WXL_ARGS_FIELD(wxl_spell_request_args, item, handle)      ///< the item the cast comes from, WXL_HANDLE_NONE for none
WXL_ARGS_FIELD(wxl_spell_request_args, target_guid, guid) ///< 0 when the client is to pick the target
WXL_ARGS_FIELD(wxl_spell_request_args, confirmed, bool)   ///< WXL_TRUE on the client's own second ask
WXL_ARGS_ANSWER(wxl_spell_request_args, refused)          ///< write WXL_TRUE to keep the client from casting
WXL_ARGS_END(wxl_spell_request_args)

/**
 * @brief The local player asking to use an item, before the client checks or sends anything.
 *
 * Writing WXL_TRUE through @ref refused answers the client as an item it could not use.
 */
WXL_ARGS(wxl_item_use_args)
WXL_ARGS_FIELD(wxl_item_use_args, item, handle)
WXL_ARGS_FIELD(wxl_item_use_args, item_guid, guid)
WXL_ARGS_FIELD(wxl_item_use_args, target_guid, guid) ///< 0 when the use has no target
WXL_ARGS_FIELD(wxl_item_use_args, confirmed, bool)   ///< WXL_TRUE on the client's own second ask, after a dialog
WXL_ARGS_ANSWER(wxl_item_use_args, refused)          ///< write WXL_TRUE to keep the client from using it
WXL_ARGS_END(wxl_item_use_args)

/**
 * @brief An event the client fires to its interface, with the arguments it passes along.
 *
 * The client formats its arguments from a C format string ("%d%s", ...) and pushes each as a
 * Lua value. They cross here already rendered, because a va_list has no layout a mod or a
 * script runtime could read: @ref values holds one entry per argument, back to back, each a
 * kind byte followed by the text and a NUL. The kind is the format letter the client used --
 * 'd' and 'u' an integer in decimal, 'f' a double printed with %.17g, 'b' a boolean as 1 or 0,
 * 's' a string as it is -- or 'n' for a string argument the client passed as null, which it
 * pushes as nil. Integers and doubles round-trip exactly; a runtime that wants typed values
 * parses them back by kind. Valid for the call only.
 */
WXL_ARGS(wxl_ui_event_args)
WXL_ARGS_FIELD(wxl_ui_event_args, index, u32)          ///< the event's index in the client's table
WXL_ARGS_FIELD(wxl_ui_event_args, name, str)           ///< the event's name, "PLAYER_ENTERING_WORLD"
WXL_ARGS_FIELD(wxl_ui_event_args, format, str)         ///< the client's format string; empty for an event without arguments
WXL_ARGS_BYTES(wxl_ui_event_args, values, values_size) ///< the entries described above, NULL when there are none
WXL_ARGS_FIELD(wxl_ui_event_args, values_size, u32)    ///< bytes in @ref values
WXL_ARGS_FIELD(wxl_ui_event_args, value_count, u32)    ///< entries in @ref values
WXL_ARGS_END(wxl_ui_event_args)

/// An error the interface's Lua raised, as the VM reports it, before the client's handler sees it.
WXL_ARGS(wxl_script_error_args)
WXL_ARGS_ENUM(wxl_script_error_args, context, wxl_script_context) ///< which interface raised it
WXL_ARGS_FIELD(wxl_script_error_args, message, str) ///< the error value as text; "UNKNOWN ERROR" when it is not text
WXL_ARGS_END(wxl_script_error_args)

/**
 * @brief A cast or a channel in progress, as the server reports it for a unit in view.
 *
 * SpellChannelStart carries the channel's length in both @ref duration and @ref remaining;
 * SpellChannelUpdate what is left, with @ref duration 0; SpellChannelStop both 0.
 * SpellCastResume, a cast already running when its caster came into view, carries both and the
 * cast's object target. Read off the message before the client parses it; the spell of a
 * channel update is the one the client holds for the unit, 0 when the unit is not in view.
 */
WXL_ARGS(wxl_spell_progress_args)
WXL_ARGS_FIELD(wxl_spell_progress_args, caster, handle)    ///< WXL_HANDLE_NONE when the caster is not in view
WXL_ARGS_FIELD(wxl_spell_progress_args, caster_guid, guid)
WXL_ARGS_FIELD(wxl_spell_progress_args, target, handle)    ///< SpellCastResume only; WXL_HANDLE_NONE otherwise, or when not in view
WXL_ARGS_FIELD(wxl_spell_progress_args, target_guid, guid) ///< SpellCastResume only; 0 otherwise, or when the cast has no object target
WXL_ARGS_FIELD(wxl_spell_progress_args, spell_id, u32)
WXL_ARGS_FIELD(wxl_spell_progress_args, duration, u32)     ///< milliseconds; 0 when the message does not say
WXL_ARGS_FIELD(wxl_spell_progress_args, remaining, u32)    ///< milliseconds left; 0 when the channel ended
WXL_ARGS_END(wxl_spell_progress_args)

/// A cast in progress pushed back by the server (SMSG_SPELL_DELAYED), for a unit in view.
WXL_ARGS(wxl_spell_delay_args)
WXL_ARGS_FIELD(wxl_spell_delay_args, caster, handle)    ///< WXL_HANDLE_NONE when the caster is not in view
WXL_ARGS_FIELD(wxl_spell_delay_args, caster_guid, guid)
WXL_ARGS_FIELD(wxl_spell_delay_args, spell_id, u32)     ///< the cast the client holds for the unit; 0 when the unit is not in view
WXL_ARGS_FIELD(wxl_spell_delay_args, delay, i32)        ///< milliseconds added to the cast
WXL_ARGS_END(wxl_spell_delay_args)

/**
 * @brief A cooldown the server put on a spell of the local player's or its pet's, or on an item.
 *
 * SMSG_SPELL_COOLDOWN names the unit and lists spells, one event each; SMSG_ITEM_COOLDOWN names
 * the item and the spell it casts, with no duration of its own. A duration of 0 is the spell's
 * own recovery time, which the client reads from its database.
 */
WXL_ARGS(wxl_spell_cooldown_args)
WXL_ARGS_FIELD(wxl_spell_cooldown_args, unit, handle)    ///< the player or the pet; WXL_HANDLE_NONE for an item's cooldown
WXL_ARGS_FIELD(wxl_spell_cooldown_args, unit_guid, guid) ///< 0 for an item's cooldown
WXL_ARGS_FIELD(wxl_spell_cooldown_args, item, handle)    ///< the item; WXL_HANDLE_NONE for a spell's cooldown
WXL_ARGS_FIELD(wxl_spell_cooldown_args, item_guid, guid) ///< 0 for a spell's cooldown
WXL_ARGS_FIELD(wxl_spell_cooldown_args, spell_id, u32)
WXL_ARGS_FIELD(wxl_spell_cooldown_args, duration, u32)   ///< milliseconds; 0 for the spell's own recovery time
WXL_ARGS_FIELD(wxl_spell_cooldown_args, flags, u32)      ///< the server's flags: 1 starts the global cooldown too, 2 ignores the on-event hold
WXL_ARGS_END(wxl_spell_cooldown_args)

/**
 * @brief A cooldown the server changed after putting it on: released from its hold
 * (SMSG_COOLDOWN_EVENT), cleared (SMSG_CLEAR_COOLDOWN) or shifted (SMSG_MODIFY_COOLDOWN).
 */
WXL_ARGS(wxl_spell_cooldown_change_args)
WXL_ARGS_FIELD(wxl_spell_cooldown_change_args, unit, handle)    ///< the player or the pet; WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_spell_cooldown_change_args, unit_guid, guid)
WXL_ARGS_FIELD(wxl_spell_cooldown_change_args, spell_id, u32)
WXL_ARGS_ENUM(wxl_spell_cooldown_change_args, change, wxl_cooldown_change) ///< WXL_COOLDOWN_SHIFTED moves it by @ref delay
WXL_ARGS_FIELD(wxl_spell_cooldown_change_args, delay, i32)      ///< milliseconds, for a shift; 0 otherwise
WXL_ARGS_END(wxl_spell_cooldown_change_args)

/**
 * @brief The local player cancelling a cast of its own, before the client tells the server.
 *
 * Every cancel ends here: the escape key, moving, SpellStopCasting, a dialog refused, the
 * client dropping a cast it cannot finish. The server is told (CMSG_CANCEL_CAST) only when
 * @ref notify_server is set and the cast had a cast time or was channelled.
 */
WXL_ARGS(wxl_spell_cancel_args)
WXL_ARGS_FIELD(wxl_spell_cancel_args, caster, handle)       ///< the player, or the pet or charmed unit it casts through
WXL_ARGS_FIELD(wxl_spell_cancel_args, caster_guid, guid)
WXL_ARGS_FIELD(wxl_spell_cancel_args, spell_id, u32)
WXL_ARGS_FIELD(wxl_spell_cancel_args, cast_count, u32)
WXL_ARGS_FIELD(wxl_spell_cancel_args, reason, u32)          ///< the client's SPELL_FAILED_* code it fails the cast with; 27 (interrupted) for the player's own cancel
WXL_ARGS_FIELD(wxl_spell_cancel_args, notify_server, bool)  ///< WXL_TRUE when the client may tell the server
WXL_ARGS_END(wxl_spell_cancel_args)

/// A unit starting or stopping its auto-attack on another, as the server reports it.
WXL_ARGS(wxl_combat_attack_args)
WXL_ARGS_FIELD(wxl_combat_attack_args, attacker, handle)    ///< WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_combat_attack_args, attacker_guid, guid)
WXL_ARGS_FIELD(wxl_combat_attack_args, victim, handle)      ///< WXL_HANDLE_NONE when not in view, or when the stop names none
WXL_ARGS_FIELD(wxl_combat_attack_args, victim_guid, guid)   ///< 0 when the stop names no victim
WXL_ARGS_END(wxl_combat_attack_args)

/**
 * @brief Damage the server reported: a melee swing, a spell, a periodic tick or the environment.
 *
 * Read off the message before the client parses it. @ref kind says which message: 0 a melee
 * round (SMSG_ATTACKERSTATEUPDATE; @ref spell_id is the swing's spell, 0 for a plain swing),
 * 1 a spell (SMSG_SPELLNONMELEEDAMAGELOG), 2 a periodic tick (SMSG_PERIODICAURALOG), 3 the
 * environment (SMSG_ENVIRONMENTALDAMAGELOG; no source, @ref environment names the cause).
 * @ref amount is what landed, after absorbs, resists and blocks. A melee round that missed
 * entirely is a CombatMiss, not a CombatDamage.
 */
WXL_ARGS(wxl_combat_damage_args)
WXL_ARGS_FIELD(wxl_combat_damage_args, source, handle)      ///< WXL_HANDLE_NONE when not in view, or for the environment
WXL_ARGS_FIELD(wxl_combat_damage_args, source_guid, guid)   ///< 0 for the environment
WXL_ARGS_FIELD(wxl_combat_damage_args, target, handle)      ///< WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_combat_damage_args, target_guid, guid)
WXL_ARGS_FIELD(wxl_combat_damage_args, spell_id, u32)       ///< 0 for a plain melee swing and for the environment
WXL_ARGS_ENUM(wxl_combat_damage_args, kind, wxl_damage_kind)
WXL_ARGS_ENUM(wxl_combat_damage_args, environment, wxl_environment) ///< meaningful for WXL_DAMAGE_ENVIRONMENT only
WXL_ARGS_FIELD(wxl_combat_damage_args, amount, u32)         ///< damage dealt
WXL_ARGS_FIELD(wxl_combat_damage_args, overkill, u32)       ///< damage past the target's health; 0 when it survived
WXL_ARGS_FIELD(wxl_combat_damage_args, school, u32)         ///< the school mask: 1 physical, 2 holy, 4 fire, 8 nature, 16 frost, 32 shadow, 64 arcane
WXL_ARGS_FIELD(wxl_combat_damage_args, absorbed, u32)
WXL_ARGS_FIELD(wxl_combat_damage_args, resisted, u32)
WXL_ARGS_FIELD(wxl_combat_damage_args, blocked, u32)
WXL_ARGS_FIELD(wxl_combat_damage_args, crit, bool)
WXL_ARGS_FIELD(wxl_combat_damage_args, hit_info, u32)       ///< the server's hit flags for a melee round or a spell; 0 for a tick or the environment
WXL_ARGS_END(wxl_combat_damage_args)

/// A heal the server reported, direct (SMSG_SPELLHEALLOG) or a periodic tick (SMSG_PERIODICAURALOG).
WXL_ARGS(wxl_combat_heal_args)
WXL_ARGS_FIELD(wxl_combat_heal_args, source, handle)      ///< WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_combat_heal_args, source_guid, guid)
WXL_ARGS_FIELD(wxl_combat_heal_args, target, handle)      ///< WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_combat_heal_args, target_guid, guid)
WXL_ARGS_FIELD(wxl_combat_heal_args, spell_id, u32)
WXL_ARGS_FIELD(wxl_combat_heal_args, amount, u32)         ///< health restored, overheal included
WXL_ARGS_FIELD(wxl_combat_heal_args, overheal, u32)       ///< the part past full health
WXL_ARGS_FIELD(wxl_combat_heal_args, absorbed, u32)
WXL_ARGS_FIELD(wxl_combat_heal_args, crit, bool)
WXL_ARGS_FIELD(wxl_combat_heal_args, periodic, bool)      ///< WXL_TRUE for a tick
WXL_ARGS_END(wxl_combat_heal_args)

/**
 * @brief An attack that did not land: a spell on one of its targets (SMSG_SPELLLOGMISS, one
 * event per target) or a melee round (SMSG_ATTACKERSTATEUPDATE).
 *
 * @ref reason is the server's SPELL_MISS_* code for a spell (1 miss, 2 resist, 3 dodge, 4
 * parry, 5 block, 6 evade, 7 immune, 8 immune, 9 deflect, 10 absorb, 11 reflect) and the
 * victim's state for a melee round (2 dodge, 3 parry, 6 evade, 7 immune, 8 deflect; 0 with the
 * miss flag in @ref hit_info for a plain miss).
 */
WXL_ARGS(wxl_combat_miss_args)
WXL_ARGS_FIELD(wxl_combat_miss_args, source, handle)      ///< WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_combat_miss_args, source_guid, guid)
WXL_ARGS_FIELD(wxl_combat_miss_args, target, handle)      ///< WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_combat_miss_args, target_guid, guid)
WXL_ARGS_FIELD(wxl_combat_miss_args, spell_id, u32)       ///< 0 for a plain melee swing
WXL_ARGS_FIELD(wxl_combat_miss_args, melee, bool)         ///< WXL_TRUE for a melee round
WXL_ARGS_FIELD(wxl_combat_miss_args, reason, u32)
WXL_ARGS_FIELD(wxl_combat_miss_args, hit_info, u32)       ///< the server's hit flags for a melee round; 0 for a spell
WXL_ARGS_END(wxl_combat_miss_args)

/**
 * @brief The player's zone, subzone or indoor state changing, as the client announces it to its
 * interface (ZONE_CHANGED, ZONE_CHANGED_INDOORS, ZONE_CHANGED_NEW_AREA).
 *
 * Raised once per change, before the client's own state and texts move: @ref new_area says the
 * area id itself changed. The texts are what the interface will show; empty when the client has
 * none.
 */
WXL_ARGS(wxl_zone_args)
WXL_ARGS_FIELD(wxl_zone_args, area_id, u32)         ///< the zone's AreaTable id
WXL_ARGS_FIELD(wxl_zone_args, subzone_id, u32)      ///< the subzone's AreaTable id, 0 for none
WXL_ARGS_FIELD(wxl_zone_args, wmo_group_id, i32)    ///< the map object group the player is in, -1 outside one
WXL_ARGS_FIELD(wxl_zone_args, zone_text, str)       ///< the zone's name
WXL_ARGS_FIELD(wxl_zone_args, subzone_text, str)    ///< the subzone's name, empty for none
WXL_ARGS_FIELD(wxl_zone_args, real_zone_text, str)  ///< the zone's name for the chat's zone channels
WXL_ARGS_FIELD(wxl_zone_args, indoors, bool)        ///< WXL_TRUE inside a map object
WXL_ARGS_FIELD(wxl_zone_args, new_area, bool)       ///< WXL_TRUE when the area id changed
WXL_ARGS_END(wxl_zone_args)

/// The object under the mouse changing, from one object to another or to none.
WXL_ARGS(wxl_mouseover_args)
WXL_ARGS_FIELD(wxl_mouseover_args, previous, handle)    ///< WXL_HANDLE_NONE when nothing was under the mouse, or it left view
WXL_ARGS_FIELD(wxl_mouseover_args, previous_guid, guid) ///< 0 when nothing was under the mouse
WXL_ARGS_FIELD(wxl_mouseover_args, current, handle)     ///< WXL_HANDLE_NONE when nothing is, or it is not in view
WXL_ARGS_FIELD(wxl_mouseover_args, current_guid, guid)  ///< 0 when nothing is
WXL_ARGS_END(wxl_mouseover_args)

/**
 * @brief A console variable changing, as the client is about to write the new value.
 *
 * Raised for every set that changes the value as a string, whoever asked -- the console, the
 * interface's SetCVar, the client's own options, a reset to default -- and not for a set that
 * leaves it as it is. The strings are valid for the call only.
 */
WXL_ARGS(wxl_cvar_args)
WXL_ARGS_FIELD(wxl_cvar_args, name, str)
WXL_ARGS_FIELD(wxl_cvar_args, previous, str) ///< the value being replaced; empty when the variable had none yet
WXL_ARGS_FIELD(wxl_cvar_args, value, str)    ///< the value being set
WXL_ARGS_END(wxl_cvar_args)

/**
 * @brief The local player's own movement, as the client sends it to the server.
 *
 * Raised once per movement message sent, for the unit the player moves: itself, or the vehicle
 * or charmed unit it controls. @ref opcode is the message: PlayerMoveStart carries a
 * MSG_MOVE_START_*, MSG_MOVE_JUMP, MSG_MOVE_START_ASCEND or MSG_MOVE_START_DESCEND;
 * PlayerMoveStop a MSG_MOVE_STOP*, MSG_MOVE_STOP_ASCEND or MSG_MOVE_FALL_LAND. @ref flags is the
 * client's movement flags after the change, @ref position and @ref facing where the unit is.
 */
WXL_ARGS(wxl_player_move_args)
WXL_ARGS_FIELD(wxl_player_move_args, unit, handle)   ///< the unit that moves; WXL_HANDLE_NONE when it is not tracked
WXL_ARGS_FIELD(wxl_player_move_args, unit_guid, guid)
WXL_ARGS_FIELD(wxl_player_move_args, opcode, u32)    ///< the MSG_MOVE_* sent
WXL_ARGS_FIELD(wxl_player_move_args, flags, u32)     ///< the movement flags: forward 1, backward 2, strafe left 4, strafe right 8, ...
WXL_ARGS_FIELD(wxl_player_move_args, position, vec3)
WXL_ARGS_FIELD(wxl_player_move_args, facing, f32)    ///< radians
WXL_ARGS_END(wxl_player_move_args)

/**
 * @brief The local player gaining a level: SMSG_LEVELUP_INFO, read before the client parses it.
 *
 * The amounts are what the level added, as the server sent them: health, one per power type in
 * the client's order, and the five stats.
 */
WXL_ARGS(wxl_level_up_args)
WXL_ARGS_FIELD(wxl_level_up_args, level, u32)       ///< the level reached
WXL_ARGS_FIELD(wxl_level_up_args, health, u32)      ///< health added
WXL_ARGS_FIELD(wxl_level_up_args, mana, u32)        ///< power added, by type: mana
WXL_ARGS_FIELD(wxl_level_up_args, rage, u32)
WXL_ARGS_FIELD(wxl_level_up_args, focus, u32)
WXL_ARGS_FIELD(wxl_level_up_args, energy, u32)
WXL_ARGS_FIELD(wxl_level_up_args, happiness, u32)
WXL_ARGS_FIELD(wxl_level_up_args, runes, u32)
WXL_ARGS_FIELD(wxl_level_up_args, runic_power, u32)
WXL_ARGS_FIELD(wxl_level_up_args, strength, u32)    ///< stats added
WXL_ARGS_FIELD(wxl_level_up_args, agility, u32)
WXL_ARGS_FIELD(wxl_level_up_args, stamina, u32)
WXL_ARGS_FIELD(wxl_level_up_args, intellect, u32)
WXL_ARGS_FIELD(wxl_level_up_args, spirit, u32)
WXL_ARGS_END(wxl_level_up_args)

/**
 * @brief The local player gaining experience: SMSG_LOG_XPGAIN, read before the client parses it.
 *
 * @ref source is the unit the experience came from, for a kill; the player itself for the rest
 * (a quest, an exploration), which the client logs without a source.
 */
WXL_ARGS(wxl_xp_gain_args)
WXL_ARGS_FIELD(wxl_xp_gain_args, source, handle)          ///< WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_xp_gain_args, source_guid, guid)
WXL_ARGS_FIELD(wxl_xp_gain_args, amount, u32)             ///< experience gained, the bonus included
WXL_ARGS_ENUM(wxl_xp_gain_args, kind, wxl_xp_source)
WXL_ARGS_FIELD(wxl_xp_gain_args, bonus, u32)              ///< the rested part of a kill's experience; 0 otherwise
WXL_ARGS_FIELD(wxl_xp_gain_args, group_multiplier, f32)   ///< the group's rate on a kill; 1 otherwise
WXL_ARGS_FIELD(wxl_xp_gain_args, refer_a_friend, bool)    ///< WXL_TRUE when the refer-a-friend bonus applied
WXL_ARGS_END(wxl_xp_gain_args)

/// The local player's money changing, raised when the server writes the field.
WXL_ARGS(wxl_money_args)
WXL_ARGS_FIELD(wxl_money_args, player, handle) ///< WXL_HANDLE_NONE when the player is not tracked
WXL_ARGS_FIELD(wxl_money_args, previous, u32)  ///< copper, before
WXL_ARGS_FIELD(wxl_money_args, current, u32)   ///< copper, after
WXL_ARGS_END(wxl_money_args)

/// The glue moving to another screen, before the new one is shown.
WXL_ARGS(wxl_glue_screen_args)
WXL_ARGS_FIELD(wxl_glue_screen_args, screen, str)   ///< "login", "charselect", "charcreate", "realmwizard", "patchdownload", "movie", ...
WXL_ARGS_FIELD(wxl_glue_screen_args, previous, str) ///< the screen being left; empty at the first
WXL_ARGS_END(wxl_glue_screen_args)

/**
 * @brief The character list of the realm, as SMSG_CHAR_ENUM carries it, before the client
 * parses it.
 *
 * Raised once with the count, then a GlueCharacter per entry in the message's order. A message
 * the client would refuse -- more than ten characters -- raises the list with @ref valid clear
 * and no entries.
 */
WXL_ARGS(wxl_character_list_args)
WXL_ARGS_FIELD(wxl_character_list_args, count, u32)
WXL_ARGS_FIELD(wxl_character_list_args, valid, bool) ///< WXL_FALSE for a list the client refuses
WXL_ARGS_END(wxl_character_list_args)

/// One character of the list. The items, the pet and the looks are not read.
WXL_ARGS(wxl_character_args)
WXL_ARGS_FIELD(wxl_character_args, index, u32)           ///< its place in the list
WXL_ARGS_FIELD(wxl_character_args, count, u32)           ///< the list's size
WXL_ARGS_FIELD(wxl_character_args, guid, guid)
WXL_ARGS_FIELD(wxl_character_args, name, str)
WXL_ARGS_FIELD(wxl_character_args, race, u32)            ///< ChrRaces id
WXL_ARGS_FIELD(wxl_character_args, class_id, u32)        ///< ChrClasses id
WXL_ARGS_FIELD(wxl_character_args, sex, u32)             ///< 0 male, 1 female
WXL_ARGS_FIELD(wxl_character_args, level, u32)
WXL_ARGS_FIELD(wxl_character_args, zone_id, u32)         ///< AreaTable id
WXL_ARGS_FIELD(wxl_character_args, map_id, u32)
WXL_ARGS_FIELD(wxl_character_args, position, vec3)
WXL_ARGS_FIELD(wxl_character_args, guild_id, u32)        ///< 0 for none
WXL_ARGS_FIELD(wxl_character_args, flags, u32)           ///< the server's character flags
WXL_ARGS_FIELD(wxl_character_args, customize_flags, u32) ///< the pending recustomisation, 0 for none
WXL_ARGS_FIELD(wxl_character_args, first_login, bool)    ///< WXL_TRUE for a character never logged in
WXL_ARGS_END(wxl_character_args)

/**
 * @brief The realm list from the logon server, as the client received it: from a Grunt logon
 * server, or built by the Battle.net login from its own realm list.
 *
 * Raised once with the count, then a GlueRealm per entry in the list's order. Both may be raised
 * on the logon connection's thread.
 */
WXL_ARGS(wxl_realm_list_args)
WXL_ARGS_FIELD(wxl_realm_list_args, count, u32)
WXL_ARGS_END(wxl_realm_list_args)

/// One realm of the list.
WXL_ARGS(wxl_realm_args)
WXL_ARGS_FIELD(wxl_realm_args, index, u32)        ///< its place in the list
WXL_ARGS_FIELD(wxl_realm_args, count, u32)        ///< the list's size
WXL_ARGS_FIELD(wxl_realm_args, name, str)
WXL_ARGS_FIELD(wxl_realm_args, address, str)      ///< "host:port"
WXL_ARGS_FIELD(wxl_realm_args, type, u32)         ///< 0 normal, 1 PvP, 6 RP, 8 RP-PvP
WXL_ARGS_FIELD(wxl_realm_args, flags, u32)        ///< the server's realm flags: 2 offline, 4 a version follows, 32 recommended, 64 new, 128 full
WXL_ARGS_FIELD(wxl_realm_args, locked, bool)      ///< WXL_TRUE for a locked realm
WXL_ARGS_FIELD(wxl_realm_args, population, f32)   ///< the server's figure, before the client maps 200/400/600 to flags
WXL_ARGS_FIELD(wxl_realm_args, characters, u32)   ///< the account's characters there
WXL_ARGS_FIELD(wxl_realm_args, category, u32)     ///< the timezone / category
WXL_ARGS_FIELD(wxl_realm_args, realm_id, u32)
WXL_ARGS_FIELD(wxl_realm_args, version_major, u32)    ///< the realm's version, when flags has 4; 0 otherwise
WXL_ARGS_FIELD(wxl_realm_args, version_minor, u32)
WXL_ARGS_FIELD(wxl_realm_args, version_revision, u32)
WXL_ARGS_FIELD(wxl_realm_args, version_build, u32)
WXL_ARGS_FIELD(wxl_realm_args, region_id, u32)        ///< Battle.net's region; 0 from a Grunt logon server
WXL_ARGS_FIELD(wxl_realm_args, battlegroup_id, u32)   ///< Battle.net's battlegroup; 0 from a Grunt logon server
WXL_ARGS_FIELD(wxl_realm_args, build, u32)            ///< the build Battle.net lists for the realm; 0 from a Grunt logon server
WXL_ARGS_END(wxl_realm_args)

/**
 * @brief The world server's answer to the login: SMSG_AUTH_RESPONSE, before the client parses
 * it.
 *
 * @ref result is the server's code: 12 (AUTH_OK) and 27 (AUTH_WAIT_QUEUE) carry the billing
 * block when the message holds it, and 27 the queue position too; any other result carries
 * nothing more.
 */
WXL_ARGS(wxl_auth_result_args)
WXL_ARGS_FIELD(wxl_auth_result_args, result, u32)
WXL_ARGS_FIELD(wxl_auth_result_args, queue_position, u32)          ///< for result 27; 0 otherwise
WXL_ARGS_FIELD(wxl_auth_result_args, billing_time_remaining, u32)
WXL_ARGS_FIELD(wxl_auth_result_args, billing_flags, u32)
WXL_ARGS_FIELD(wxl_auth_result_args, billing_time_rested, u32)
WXL_ARGS_FIELD(wxl_auth_result_args, expansion, u32)               ///< the account's expansion level: 0 classic, 1 TBC, 2 WotLK
WXL_ARGS_FIELD(wxl_auth_result_args, free_character_migration, bool)
WXL_ARGS_END(wxl_auth_result_args)

/// The client asking to enter the world with a character, before CMSG_PLAYER_LOGIN is sent.
WXL_ARGS(wxl_enter_world_args)
WXL_ARGS_FIELD(wxl_enter_world_args, character_guid, guid)
WXL_ARGS_END(wxl_enter_world_args)

/**
 * @brief A line of the chat that a chat message of the server became: the line the client shows.
 *
 * Raised when the client commits the line, after every filter it runs and just before the chat
 * frames receive it as their CHAT_MSG_* event, and only then. A message the client drops raises
 * nothing: one from an ignored player (a GM's excepted), a creature's said to an ignored player,
 * a whisper the client's stranger filter refuses, a message with bytes left over, a line the spam
 * filter or the UTF-8 check refuses. A line the client holds until it knows a name (the sender's
 * or the target's is not in its name cache yet, or the world is still loading) is raised when it
 * is shown, from the copy the client kept; one it then gives up on raises nothing. An addon
 * message is not a line: it raises ChatAddonMessage.
 *
 * @ref type is the CHAT_MSG_* code the line is shown under: a foreign whisper (8 on the wire)
 * is a whisper, 7; a say or a yell with no text is an emote, 10. @ref text is the text as the
 * server sent it, @ref shown_text the line as the frames receive it: in the languages the
 * player knows, with the profanity filter applied. @ref sender_name is the name the line shows,
 * the message's own or the client's name cache's; @ref target_name only as the message carries
 * it. The strings are valid for the call only.
 */
WXL_ARGS(wxl_chat_args)
WXL_ARGS_FIELD(wxl_chat_args, type, u32)            ///< CHAT_MSG_*: 0 system, 1 say, 2 party, 5 officer, 6 yell, 7 whisper, 10 emote, 17 channel, ...
WXL_ARGS_FIELD(wxl_chat_args, language, u32)        ///< Languages id the message was said in
WXL_ARGS_FIELD(wxl_chat_args, sender, handle)       ///< WXL_HANDLE_NONE when the sender is not in view
WXL_ARGS_FIELD(wxl_chat_args, sender_guid, guid)    ///< 0 for a system message
WXL_ARGS_FIELD(wxl_chat_args, sender_name, str)     ///< empty when the line shows none
WXL_ARGS_FIELD(wxl_chat_args, target_guid, guid)    ///< the unit the message is said to, 0 for none
WXL_ARGS_FIELD(wxl_chat_args, target_name, str)     ///< empty when the message carries none
WXL_ARGS_FIELD(wxl_chat_args, channel, str)         ///< the channel's name for type 17, empty otherwise
WXL_ARGS_FIELD(wxl_chat_args, text, str)            ///< as the server sent it
WXL_ARGS_FIELD(wxl_chat_args, tag, u32)             ///< the sender's chat tag: 1 AFK, 2 DND, 4 GM, 16 dev
WXL_ARGS_FIELD(wxl_chat_args, achievement_id, u32)  ///< for an achievement message, 0 otherwise
WXL_ARGS_FIELD(wxl_chat_args, gm, bool)             ///< WXL_TRUE for SMSG_GM_MESSAGECHAT
WXL_ARGS_FIELD(wxl_chat_args, line_id, u32)         ///< the client's number for the line, the lineID of its CHAT_MSG_* event
WXL_ARGS_FIELD(wxl_chat_args, shown_text, str)      ///< as the chat frames receive it
WXL_ARGS_END(wxl_chat_args)

/**
 * @brief An addon message of the server, as the client delivers it to the interface as
 * CHAT_MSG_ADDON.
 *
 * A chat message in the addon language (0xFFFFFFFF) is not shown: the client splits its text at
 * the first tab into the prefix and the message and fires CHAT_MSG_ADDON with them. Raised just
 * before it does, with what the interface receives, and only then: a message the client drops
 * raises nothing (one from an ignored player, a message with bytes left over), and one it holds
 * until it knows the sender's name is raised when it delivers it, with that name. The spam
 * filter and the UTF-8 check do not apply to addon messages. The strings are valid for the call
 * only.
 */
WXL_ARGS(wxl_chat_addon_args)
WXL_ARGS_FIELD(wxl_chat_addon_args, type, u32)          ///< the CHAT_MSG_* code it came as: 2 party, 3 raid, 4 guild, 7 whisper, 44 battleground, ...
WXL_ARGS_FIELD(wxl_chat_addon_args, sender, handle)     ///< WXL_HANDLE_NONE when the sender is not in view
WXL_ARGS_FIELD(wxl_chat_addon_args, sender_guid, guid)
WXL_ARGS_FIELD(wxl_chat_addon_args, sender_name, str)   ///< the name CHAT_MSG_ADDON carries; empty when the client has none
WXL_ARGS_FIELD(wxl_chat_addon_args, prefix, str)        ///< the text before the first tab
WXL_ARGS_FIELD(wxl_chat_addon_args, text, str)          ///< the text after it; empty without a tab
WXL_ARGS_FIELD(wxl_chat_addon_args, channel, str)       ///< "PARTY", "RAID", "GUILD", "WHISPER", "BATTLEGROUND" or "UNKNOWN"
WXL_ARGS_FIELD(wxl_chat_addon_args, gm, bool)           ///< WXL_TRUE for SMSG_GM_MESSAGECHAT
WXL_ARGS_END(wxl_chat_addon_args)

/**
 * @brief The local player sending a message from the interface: SendChatMessage or
 * SendAddonMessage, as the script called them, before the client checks or sends anything.
 *
 * The strings are the script's arguments as they were passed, @ref type the chat type's name
 * ("SAY", "WHISPER", ...) or empty for the default. Writing WXL_TRUE through @ref suppressed
 * answers the script as a message that was not sent: nothing is checked, nothing is sent, no
 * error is raised. A handler that wants the text changed suppresses the message and sends its
 * own through the script service; the arguments cannot be rewritten in place.
 */
WXL_ARGS(wxl_chat_send_args)
WXL_ARGS_FIELD(wxl_chat_send_args, text, str)
WXL_ARGS_FIELD(wxl_chat_send_args, type, str)       ///< "SAY", "YELL", "PARTY", "WHISPER", "CHANNEL", ...; empty for the default
WXL_ARGS_FIELD(wxl_chat_send_args, language, str)   ///< the language's name; empty for the default
WXL_ARGS_FIELD(wxl_chat_send_args, target, str)     ///< the player whispered or the channel; empty for none
WXL_ARGS_FIELD(wxl_chat_send_args, prefix, str)     ///< the addon prefix; empty for a chat message
WXL_ARGS_FIELD(wxl_chat_send_args, addon, bool)     ///< WXL_TRUE for SendAddonMessage
WXL_ARGS_ANSWER(wxl_chat_send_args, suppressed)     ///< write WXL_TRUE to keep the client from sending it
WXL_ARGS_END(wxl_chat_send_args)

/**
 * @brief Power given or drained, as the server reported it: SMSG_SPELLENERGIZELOG, or an
 * energize or drain tick of SMSG_PERIODICAURALOG.
 *
 * @ref amount is the power moved, of @ref power_type (0 mana, 1 rage, 2 focus, 3 energy, 4
 * happiness, 5 runes, 6 runic power). A drain takes it from @ref target; @ref multiplier is
 * the share the caster gains, as the server sent it.
 */
WXL_ARGS(wxl_combat_energize_args)
WXL_ARGS_FIELD(wxl_combat_energize_args, source, handle)      ///< WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_combat_energize_args, source_guid, guid)
WXL_ARGS_FIELD(wxl_combat_energize_args, target, handle)      ///< WXL_HANDLE_NONE when not in view
WXL_ARGS_FIELD(wxl_combat_energize_args, target_guid, guid)
WXL_ARGS_FIELD(wxl_combat_energize_args, spell_id, u32)
WXL_ARGS_FIELD(wxl_combat_energize_args, power_type, u32)
WXL_ARGS_FIELD(wxl_combat_energize_args, amount, u32)
WXL_ARGS_FIELD(wxl_combat_energize_args, periodic, bool)      ///< WXL_TRUE for a tick
WXL_ARGS_FIELD(wxl_combat_energize_args, drain, bool)         ///< WXL_TRUE when the power was taken from the target
WXL_ARGS_FIELD(wxl_combat_energize_args, multiplier, f32)     ///< for a drain; 0 otherwise
WXL_ARGS_END(wxl_combat_energize_args)

/**
 * @brief An element of a descriptor field changed on an object, as an update of the server
 * applied it: only for a field wxl_object_api's watch_field asked for.
 *
 * @ref field is the dword index of the element (update_fields.def): the field's first dword for
 * a field of one element, the element's own for an array, such as one power of
 * UNIT_FIELD_POWER_REGEN_FLAT_MODIFIER. @ref count is the element's size in dwords, 2 for a guid
 * or another 64-bit value and 1 for the others; the values hold that many dwords, low first,
 * and zeros above.
 */
WXL_ARGS(wxl_object_field_args)
WXL_ARGS_FIELD(wxl_object_field_args, object, handle)
WXL_ARGS_ENUM(wxl_object_field_args, type, wxl_object_type)
WXL_ARGS_FIELD(wxl_object_field_args, field, u32)                 ///< the element's dword index
WXL_ARGS_FIELD(wxl_object_field_args, count, u32)                 ///< its size in dwords, 1 or 2
WXL_ARGS_VALUE(wxl_object_field_args, old_value, type, field)     ///< before the update
WXL_ARGS_VALUE(wxl_object_field_args, new_value, type, field)     ///< as the update left it
WXL_ARGS_END(wxl_object_field_args)

/**
 * @brief An archive the client mounted or let go of.
 *
 * @ref path is the path it was opened by. The table sizes are its header's: how many entries its
 * hash and block tables hold. @ref bytes is what its tables and listfile hold in memory when the
 * event is raised: for a mount the tables just read, for an unmount all it held.
 */
WXL_ARGS(wxl_archive_args)
WXL_ARGS_FIELD(wxl_archive_args, path, str)
WXL_ARGS_FIELD(wxl_archive_args, priority, i32)        ///< higher wins a name
WXL_ARGS_FIELD(wxl_archive_args, hash_entries, u32)
WXL_ARGS_FIELD(wxl_archive_args, block_entries, u32)
WXL_ARGS_FIELD(wxl_archive_args, bytes, u64)
WXL_ARGS_END(wxl_archive_args)

/**
 * @brief The address space is running short.
 *
 * Raised when the largest free block falls under the highest threshold a mod asked
 * wxl.footprint's watch_pressure for, and again only once it has risen back above. An
 * allocation larger than @ref largest_free fails, however much is free in all.
 */
WXL_ARGS(wxl_memory_pressure_args)
WXL_ARGS_FIELD(wxl_memory_pressure_args, largest_free, u64) ///< the largest free block, in bytes
WXL_ARGS_FIELD(wxl_memory_pressure_args, free, u64)         ///< every free block together
WXL_ARGS_FIELD(wxl_memory_pressure_args, committed, u64)    ///< what the process has committed
WXL_ARGS_FIELD(wxl_memory_pressure_args, threshold, u64)    ///< the threshold it fell under
WXL_ARGS_END(wxl_memory_pressure_args)

