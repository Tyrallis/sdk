//
// The field table: every member of every args struct of events.h, in declaration order, with
// what it carries. A runtime that hands events to something other than C -- a script VM, a log,
// a recorder -- reads an args struct through these rows instead of a binding written per event.
//
//   WXL_FIELD(args, member, kind)              a value, read as it is
//   WXL_FIELD_BYTES(args, member, size)        `const void*` to `size` bytes, valid for the call
//   WXL_FIELD_ANSWER(args, member)             `wxl_bool*` a handler writes WXL_TRUE through
//   WXL_FIELD_BUFFER(args, member, capacity)   `char*` a handler writes a NUL-terminated string
//                                              into, at most `capacity` bytes with the terminator
//
// Columns:
//
//   args    the struct, as events.def names it
//   member  the member's name in that struct
//   kind    what the value means, not only its C type:
//             u32 i32 u64 i64 f32   the integer or float of that width
//             bool                  a wxl_bool
//             handle                a wxl_handle: a client object, through wxl.object
//             guid                  a wxl_guid: the server's id for an object
//             vec3                  a wxl_vec3
//             str                   a wxl_str, valid for the call
//             ptr                   an address only native code can use; never dereferenced
//   size, capacity   the member of the same struct holding the length
//
// Every member is listed, so a struct is fully described: the SDK's contract test rebuilds each
// struct's layout from these rows and fails when a member is missing, out of order or of another
// type than its kind. A struct added to events.h gets its rows here in the same change.
//
// Include with WXL_FIELD defined. The other shapes default to WXL_FIELD with their own kind --
// bytes, answer, buffer -- for a consumer that only wants the members.

#ifndef WXL_FIELD
#error "define WXL_FIELD(args, member, kind) before including fields.def"
#endif

#ifndef WXL_FIELD_BYTES
    #define WXL_FIELD_BYTES(args, member, size) WXL_FIELD(args, member, bytes)
    #define WXL_FIELD_BYTES_DEFAULTED
#endif
#ifndef WXL_FIELD_ANSWER
    #define WXL_FIELD_ANSWER(args, member) WXL_FIELD(args, member, answer)
    #define WXL_FIELD_ANSWER_DEFAULTED
#endif
#ifndef WXL_FIELD_BUFFER
    #define WXL_FIELD_BUFFER(args, member, capacity) WXL_FIELD(args, member, buffer)
    #define WXL_FIELD_BUFFER_DEFAULTED
#endif

WXL_FIELD(wxl_frame_args, index, u64)
WXL_FIELD(wxl_frame_args, delta, f32)

