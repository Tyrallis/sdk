#ifdef WXL_FIELD_BYTES_DEFAULTED
    #undef WXL_FIELD_BYTES
    #undef WXL_FIELD_BYTES_DEFAULTED
#endif
#ifdef WXL_FIELD_ANSWER_DEFAULTED
