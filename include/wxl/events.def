//
// The event table: one row per event, and the single source of the event enum, of the C++ hook
// methods and of the event -> args binding.
//
// Include it with WXL_EVENT(family, name, id, args) defined. Expanders ignore the columns they do
// not need.
//
//   family  which C++ script class carries the hook
//   name    the event's name; the C++ method is On<name>, the enum value WXL_EV_<name>
//   id      the ABI. Appended with the next free number, never renumbered, never removed.
//   args    the struct passed to handlers, declared in events.h
//
// Only events every runtime can raise belong here. A hook that exists because of how one client
// happens to be built is published by that runtime as a service of its own, not added below.
//
// Handlers run on the client's main thread, except where a row says it may be raised elsewhere.

// Two ways to consume it, and nothing to remember:
//
//   define WXL_EVENT(family, name, id, args)       -- every row, family as an argument
//   define WXL_EVENT_<family>(name, id, args)      -- only the families you name
//
// Whatever is left undefined defaults below and is cleaned up at the end, so a runtime that
// serves one family writes one macro and a mod that wants the whole table writes the other.

#if !defined(WXL_EVENT) && !defined(WXL_EVENT_World) && !defined(WXL_EVENT_Render) && \
    !defined(WXL_EVENT_Object) && !defined(WXL_EVENT_Asset) && !defined(WXL_EVENT_Net) && \
    !defined(WXL_EVENT_Lua)
    #error "define WXL_EVENT(family, name, id, args) or a WXL_EVENT_<family> before events.def"
#endif

#ifndef WXL_EVENT
    #define WXL_EVENT(family, name, id, args) WXL_EVENT_##family(name, id, args)
    #define WXL_EVENT_DEFAULTED
#endif
#ifndef WXL_EVENT_World
    #define WXL_EVENT_World(name, id, args)
    #define WXL_EVENT_World_DEFAULTED
#endif
#ifndef WXL_EVENT_Render
    #define WXL_EVENT_Render(name, id, args)
    #define WXL_EVENT_Render_DEFAULTED
#endif
#ifndef WXL_EVENT_Object
    #define WXL_EVENT_Object(name, id, args)
    #define WXL_EVENT_Object_DEFAULTED
#endif
#ifndef WXL_EVENT_Asset
    #define WXL_EVENT_Asset(name, id, args)
    #define WXL_EVENT_Asset_DEFAULTED
#endif
#ifndef WXL_EVENT_Net
    #define WXL_EVENT_Net(name, id, args)
    #define WXL_EVENT_Net_DEFAULTED
#endif
#ifndef WXL_EVENT_Lua
    #define WXL_EVENT_Lua(name, id, args)
    #define WXL_EVENT_Lua_DEFAULTED
#endif

// --- World: the game's own facts -----------------------------------------------------------

/** The logic tick advanced. */
WXL_EVENT(World, Update,        0, wxl_update_args)
/** The world finished loading and the player is in it. */
WXL_EVENT(World, WorldEnter,    1, wxl_world_args)
/** The world is being torn down; the map being left is still loaded. */
WXL_EVENT(World, WorldLeave,    2, wxl_world_args)
/** A click resolved to a point in the world, and possibly to an object. */
WXL_EVENT(World, WorldClick,    3, wxl_world_click_args)
/** Raw input arrived. A handler may swallow it. */
WXL_EVENT(World, Input,         4, wxl_input_args)
/** A sound is about to play. A handler may suppress it. */
WXL_EVENT(World, SoundPlay,     5, wxl_sound_args)

// --- Render: the slots of a frame --------------------------------------------------------
//
// These carry no device. A mod that needs to draw asks the runtime for its graphics service; what
// the slots guarantee is *when* they run, which is the part every runtime can promise.

/** A frame is starting, before anything is drawn. */
WXL_EVENT(Render, FrameBegin,        6, wxl_frame_args)
/** The frame is drawn and about to be presented. */
WXL_EVENT(Render, FrameEnd,          7, wxl_frame_args)
/** The world pass is about to draw. */
WXL_EVENT(Render, WorldRenderBegin,  8, wxl_frame_args)
/** The world is drawn and the interface is not: the post-process slot. */
WXL_EVENT(Render, WorldRenderEnd,    9, wxl_frame_args)
/** The interface is drawn: the overlay slot, on top of everything. */
WXL_EVENT(Render, UiRenderEnd,      10, wxl_frame_args)
/** Swapchain resources are about to be released; release anything derived from them. */
WXL_EVENT(Render, SwapchainLost,    11, wxl_swapchain_args)
/** The swapchain is back; recreate what was released. */
WXL_EVENT(Render, SwapchainRestored,12, wxl_swapchain_args)

// --- Object: what lives in the world -----------------------------------------------------

/** An object entered the client's view. */
WXL_EVENT(Object, ObjectCreate,     13, wxl_object_args)
/** An object's server-side fields changed. */
WXL_EVENT(Object, ObjectUpdate,     14, wxl_object_args)
/** An object is about to leave; it is still resident and its handle still resolves. */
WXL_EVENT(Object, ObjectDestroy,    15, wxl_object_args)
/** The player's target changed. */
WXL_EVENT(Object, TargetChanged,    16, wxl_target_args)
/** A map doodad was placed. */
WXL_EVENT(Object, DoodadSpawn,      17, wxl_doodad_args)
/** A unit's equipment slot was filled or cleared. */
WXL_EVENT(Object, EquipmentChanged, 18, wxl_equipment_args)

// --- Asset: what comes off disk ----------------------------------------------------------

/** A model's bytes were read, before they are parsed. A handler may substitute them. */
WXL_EVENT(Asset, ModelLoad,         19, wxl_model_load_args)
/** A texture was requested by name. Fires on every reference, cached or not. */
WXL_EVENT(Asset, TextureLoad,       20, wxl_texture_load_args)
/** A terrain chunk is being built. */
WXL_EVENT(Asset, TerrainChunkBuild, 21, wxl_terrain_chunk_args)
/** A map object's root was read, before its sub-chunks are walked. */
WXL_EVENT(Asset, MapObjectLoad,     22, wxl_map_object_args)
/** A file is about to be opened by name. A handler may answer with another path. May be raised
    on any thread that opens files. */
WXL_EVENT(Asset, FileOpen,          29, wxl_file_open_args)
/** A file open finished, whether or not it found anything. */
WXL_EVENT(Asset, FileOpened,        30, wxl_file_opened_args)
/** A client database finished loading; its records are readable. */
WXL_EVENT(Asset, ClientDbLoaded,    31, wxl_client_db_args)

// --- Net: what crosses to the server -----------------------------------------------------
//
// The payload is the wire body, after the opcode and before any client parsing. A handler may
// suppress a message in either direction; suppressing an incoming one hides it from the client
// entirely, which is how a mod serves an opcode the client does not know.

/** A message arrived from the server, before the client dispatches it. */
WXL_EVENT(Net, MessageReceived, 23, wxl_message_args)
/** A message is about to go to the server. May be raised on the connection's own thread. */
WXL_EVENT(Net, MessageSent,     24, wxl_message_args)
/** The connection to the world server came up. */
WXL_EVENT(Net, Connected,       25, wxl_connection_args)
/** The connection went away, for any reason. */
WXL_EVENT(Net, Disconnected,    26, wxl_connection_args)

// --- Lua: the script VM ------------------------------------------------------------------
//
// The client runs two script contexts in turn: the login glue and the game. Each is created and
// destroyed more than once in a session, so anything registered on one is registered again on the
// next -- these events are where that happens.

/** A script context exists and can be registered on. */
WXL_EVENT(Lua, ScriptVmReady,   27, wxl_script_vm_args)
/** A script context is about to be destroyed. Anything held on it dies with it. */
WXL_EVENT(Lua, ScriptVmClosing, 28, wxl_script_vm_args)

// --- Object, continued -------------------------------------------------------------------

/** A unit died. */
WXL_EVENT(Object, UnitDeath,       32, wxl_unit_args)
/** An aura was applied to or removed from a unit. */
WXL_EVENT(Object, UnitAuraChanged, 33, wxl_unit_aura_args)

// Casts, as the server tells the client about them (any caster in view) and as the local player
// asks for them. The two requests carry an answer a handler writes to refuse the request.

/** A unit in view started a cast: the server's SMSG_SPELL_START, before the client parses it. */
WXL_EVENT(Object, SpellCastStart,       34, wxl_spell_cast_args)
/** A cast went off: SMSG_SPELL_GO, with the hits and misses counted. */
WXL_EVENT(Object, SpellCastGo,          35, wxl_spell_cast_args)
/** A cast of the local player's failed, with the client's reason; the client's own refusals too. */
WXL_EVENT(Object, SpellCastFailed,      36, wxl_spell_fail_args)
/** A cast in progress was stopped by the server: SMSG_SPELL_FAILURE, for any caster in view. */
WXL_EVENT(Object, SpellCastInterrupted, 37, wxl_spell_fail_args)
/** The local player asks to cast a spell. A handler may refuse it. */
WXL_EVENT(Object, SpellCastRequest,     38, wxl_spell_request_args)
/** The local player asks to use an item. A handler may refuse it. */
WXL_EVENT(Object, ItemUseRequest,       39, wxl_item_use_args)

// --- Lua, continued ----------------------------------------------------------------------

/** The client fires an event to its interface, with the values it passes along. */
WXL_EVENT(Lua, UiEvent,     40, wxl_ui_event_args)
/** The interface's Lua raised an error, before the client's error handler sees it. */
WXL_EVENT(Lua, ScriptError, 41, wxl_script_error_args)

// Give back whatever was defaulted above, so the file can be included again right after with a
// different selector. What the consumer defined itself is left alone: undefining it here would
// break the consumer that includes the table twice on purpose.

#ifdef WXL_EVENT_DEFAULTED
    #undef WXL_EVENT
    #undef WXL_EVENT_DEFAULTED
#endif
#ifdef WXL_EVENT_World_DEFAULTED
    #undef WXL_EVENT_World
    #undef WXL_EVENT_World_DEFAULTED
#endif
#ifdef WXL_EVENT_Render_DEFAULTED
    #undef WXL_EVENT_Render
    #undef WXL_EVENT_Render_DEFAULTED
#endif
#ifdef WXL_EVENT_Object_DEFAULTED
    #undef WXL_EVENT_Object
    #undef WXL_EVENT_Object_DEFAULTED
#endif
#ifdef WXL_EVENT_Asset_DEFAULTED
    #undef WXL_EVENT_Asset
    #undef WXL_EVENT_Asset_DEFAULTED
#endif
#ifdef WXL_EVENT_Net_DEFAULTED
    #undef WXL_EVENT_Net
    #undef WXL_EVENT_Net_DEFAULTED
#endif
#ifdef WXL_EVENT_Lua_DEFAULTED
    #undef WXL_EVENT_Lua
    #undef WXL_EVENT_Lua_DEFAULTED
#endif
